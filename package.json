{
  "name": "jacksonochoa-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Jackson Ochoa — end-to-end web products portfolio",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-pages-files.mjs",
    "start": "npx --yes serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "16.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "brace-expansion@^5.0.0": "^5.0.8",
    "postcss": "^8.5.23"
  }
}
